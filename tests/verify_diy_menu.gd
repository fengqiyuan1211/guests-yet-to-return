extends "res://tests/verify_research.gd"

func run() -> void:
	WorkbenchSession.reset_game()
	check(MenuCatalog.save_menu([],MenuCatalog.DEFAULT_DESIGN),"empty official menu fixture")
	var official:=MenuCatalog.all_recipes()
	op("begin_research",{"mode":"research_diy"})
	op("cup",{"cup":"rocks"})
	op("withdraw",{"material":"gin","ml":30,"vessel":"glass"})
	op("withdraw",{"material":"lime","ml":15,"vessel":"glass"})
	op("finish")
	check(MenuCatalog.get_recipe("diy_1").is_empty(),"unsaved trial cannot be listed")
	op("save_research",{"name":"港口晚风","english_name":"Harbor Breeze","notes":"30 ml 金酒加15 ml青柠汁。"})
	var stored: Dictionary=WorkbenchSession.research_recipes()[0]
	var recipe:=MenuCatalog.get_recipe("diy_1")
	check(MenuCatalog.entries.is_empty(),"saving DIY does not auto-list")
	check(recipe.name=="港口晚风" and recipe.category=="DIY" and recipe.unlocked,"existing saved DIY is available")
	check(recipe.price_status=="fixed_ingredient_cost" and not recipe.preview_only,"DIY has fixed ingredient cost price")
	check(MenuCatalog.all_recipes()==official and not MenuCatalog.unlocked_ids.has("diy_1"),"official catalogue and unlock ledger untouched")
	check(WorkbenchSession.research_recipes()[0]==stored,"menu adapter never mutates saved recipe")
	check(MenuCatalog.unlocked_ids.size()<=MenuCatalog.all_recipes().size(),"official codex progress excludes DIY")
	home=load("res://scenes/home.tscn").instantiate()
	add_child(home)
	await settle()
	Navigation.go_to(&"menu")
	await settle()
	bench=home.active_page
	var card: Button=bench.find_child("Recipe_diy_1",true,false)
	check(card!=null,"DIY appears in real menu editor")
	click(card)
	await settle()
	check(bench.selected.size()==1 and bench.selected[0].id=="diy_1","native click selects DIY")
	for child in bench.receipt.get_children():
		check(not child is SpinBox,"no editable price field")
	check(bench.selected[0].price==recipe.reference_price,"DIY fixed price shown")
	await capture("diy-menu-01-editor")
	bench._go_editor()
	await settle()
	bench._save()
	check(MenuCatalog.entries==[{"id":"diy_1","price":recipe.reference_price}],"editor saves custom menu")
	check(MenuCatalog.menu_for_ai().selected_drinks[0].id=="diy_1","published/AI payload includes DIY")
	var snapshot:=MenuCatalog.entries.duplicate(true)
	check(not MenuCatalog.save_menu([{"id":"diy_99999","price":30}],{}),"unknown DIY cannot be listed")
	check(not MenuCatalog.save_menu([{"id":"sample_mojito","price":30}],{}),"design samples cannot be sold")
	check(not MenuCatalog.save_menu([{"id":"diy_1","price":0}],{}),"invalid price rejected")
	check(MenuCatalog.entries==snapshot,"rejected saves preserve menu")
	var path: String=MenuCatalog.save_path
	MenuCatalog.save_path=path+"/unwritable.json"
	check(not MenuCatalog.save_menu([{"id":"diy_1","price":99}],{}),"failed write rejected")
	MenuCatalog.save_path=path
	check(MenuCatalog.entries==snapshot,"failed write preserves published price")
	check(MenuCatalog.load_state() and MenuCatalog.entries==snapshot,"DIY listing reloads")
	Navigation.go_to(&"home")
	TimeManager.advance_minutes(1200-TimeManager.minutes_since_midnight)
	await settle()
	home._on_talk_pressed()
	Navigation.go_to(&"drink_selection")
	await settle()
	bench=home.active_page
	check(bench.buttons.has("diy_1") and bench.title.text=="港口晚风","guest can choose published DIY")
	check(bench.diy_preview.visible and bench.diy_preview.result==stored.result,"guest sees saved DIY cup")
	await capture("diy-menu-02-selection")
	var inspiration: int=WorkbenchSession.research_state().inspiration
	click(bench.start_button)
	await settle()
	bench=home.active_page
	check(Navigation.current_route==&"mixing","DIY starts business workbench")
	if Navigation.current_route!=&"mixing":
		get_tree().quit(1)
		return
	var session: Dictionary=WorkbenchSession.state.session
	check(session.mode=="workbench" and session.cup=="rocks","business mode preserves DIY cup")
	check(session.recipe.id=="diy_1" and session.recipe.ingredients=={"gin":30.0,"lime":15.0},"business freezes exact DIY ingredients")
	check(session.recipe.version==stored.version and session.recipe.ingredient_rows==stored.ingredients,"saved version and targets preserved")
	check(bench.recipe_title.text.contains("港口晚风"),"top-left recipe shows DIY name")
	var stock: float=WorkbenchSession.remaining("gin")
	op("withdraw",{"material":"gin","ml":30,"vessel":"glass"})
	op("withdraw",{"material":"lime","ml":15,"vessel":"glass"})
	op("finish")
	check(WorkbenchSession.remaining("gin")==stock-30 and WorkbenchSession.research_state().inspiration==inspiration,"business deducts stock without research fee")
	check(WorkbenchSession.state.session.result.evaluation.score!=null,"DIY business cup receives production quality")
	check(WorkbenchSession.research_recipes()[0]==stored,"business cup cannot overwrite DIY recipe")
	var expected:=FileAccess.open(Supplies.save_path+".expected",FileAccess.WRITE)
	expected.store_string(JSON.stringify({"workbench":WorkbenchSession.snapshot(),"supplies":Supplies.serialize(),"entries":MenuCatalog.entries}))
	expected.close()
	print("DIY MENU: %d checks, %d failures" % [count,failures.size()])
	home.queue_free()
	await settle()
	get_tree().quit(0 if failures.is_empty() else 1)

func resume_check() -> void:
	var expected: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(Supplies.save_path+".expected"))
	check(MenuCatalog.writable and not MenuCatalog._waiting_for_research,"startup waits for validated DIY then enables menu")
	check(same(MenuCatalog.entries,expected.entries),"new process preserves DIY listing and price")
	check(same(WorkbenchSession.snapshot(),expected.workbench) and same(Supplies.serialize(),expected.supplies),"startup preserves research, actual cup and inventory")
	check(MenuCatalog.get_recipe("diy_1").name=="港口晚风","new process resolves DIY reference")
	check(MenuCatalog.save_state(),"restored DIY menu can still be saved")
	check(Supplies.last_error.is_empty(),"startup supply synchronization succeeds")
	print("DIY MENU RESTORE: %d checks, %d failures" % [count,failures.size()])
	get_tree().quit(0 if failures.is_empty() else 1)
