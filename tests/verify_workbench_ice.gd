extends "res://tests/verify_workbench_drag.gd"
const Ice=preload("res://scripts/workbench_ice.gd")

func wait_settled() -> void:
	await get_tree().create_timer(1.7).timeout

func cup(value: String) -> void:
	bench._act("cup",{"cup":value})

func run() -> void:
	WorkbenchSession.reset_game()
	home=load("res://scenes/home.tscn").instantiate()
	add_child(home)
	await settle()
	Navigation.go_to(&"mixing")
	await settle()
	bench=home.active_page
	cup("highball")
	bench._show_category("冰块")
	var stock: Dictionary=WorkbenchSession.state.stock.duplicate(true)
	from_pantry("cube","glass")
	check(WorkbenchSession.state.session.vessels.glass.ice=="cube","native drop adds standard ice")
	check(WorkbenchSession.state.stock==stock,"ice visual change preserves existing inventory rules")
	check(bench.table.ice_effects.has("glass"),"new ice schedules entry animation")
	bench.table.set_process(false)
	bench.table.clock=float(bench.table.ice_effects.glass)+.24
	await capture("20-ice-entering")
	bench.table.clock=float(bench.table.ice_effects.glass)+2.0
	await capture("21-dry-cubes")
	bench.table.set_process(true)
	bench._issue("withdraw",{"material":"gin","ml":60,"vessel":"glass"})
	bench._issue("withdraw",{"material":"lime","ml":30,"vessel":"glass"})
	await wait_settled()
	var event_time: float=bench.table.ice_effects.glass
	await capture("22-ice-highball")
	bench._act("garnish",{"material":"garnish"})
	check(bench.table.ice_effects.glass==event_time,"garnish does not replay ice falling")
	check(WorkbenchSession.amount(WorkbenchSession.state.session.vessels.glass)==90,"rendered ice never counts as liquid volume")
	var before: Dictionary=WorkbenchSession.snapshot()
	from_pantry("cube","glass")
	check(WorkbenchSession.ice_batches(WorkbenchSession.state.session.vessels.glass).size()==2,"second drop adds another portion")
	event_time=bench.table.ice_effects.glass
	cup("glass_balloon_glass")
	await wait_settled()
	await capture("23-ice-coupe")
	check(WorkbenchSession.amount(WorkbenchSession.state.session.vessels.glass)==90 and bench.table.ice_effects.glass==event_time,"changing cup preserves liquid ice and animation age")
	cup("glass_balloon_glass")
	await capture("24-ice-balloon")
	var sample:=Rect2(0,0,120,220)
	var dry:=Ice.pieces(sample,"cube",0,300,false,false,10,0)
	var wet:=Ice.pieces(sample,"cube",160,300,false,false,10,0)
	var dry_average:=0.0
	var wet_average:=0.0
	for piece in dry: dry_average+=piece.point.y/dry.size()
	for piece in wet: wet_average+=piece.point.y/wet.size()
	check(wet_average<dry_average-15,"ice floats higher as vessel fills instead of staying fixed on sprite")
	check(Ice.displacement(0,"cube")==0 and Ice.displacement(2,"cube")==1,"displacement grows only as ice reaches the vessel")
	check(Ice.displacement(.6,"crushed")<1,"crushed ice enters in a staggered shower")
	var early:=Ice.pieces(sample,"cube",90,300,false,false,.1,0)
	check(early[0].point.y<wet[0].point.y,"early falling pieces begin above settled position")
	var shapes:=Ice.faces(wet[0])
	check(Geometry2D.triangulate_polygon(shapes[0]).size()>0 and Geometry2D.triangulate_polygon(shapes[1]).size()>0,"volumetric faces are valid drawable polygons")
	# Mixing glass has opaque source art; its interior overlay must still show ice.
	bench._issue("withdraw",{"material":"gin","ml":60,"vessel":"mixing"})
	bench._issue("withdraw",{"material":"syrup","ml":30,"vessel":"mixing"})
	from_pantry("cube","mixing")
	await wait_settled()
	await capture("25-ice-mixing")
	bench._act("filter",{"source":"mixing","vessel":"glass"})
	await wait_settled()
	check(WorkbenchSession.state.session.vessels.mixing.ice=="cube" and WorkbenchSession.amount(WorkbenchSession.state.session.vessels.mixing)==0,"filter retains ice while liquid drains")
	# Store and reopen: same ice, no arrival animation replay.
	before=WorkbenchSession.snapshot()
	Navigation.go_to(&"home")
	await settle()
	Navigation.go_to(&"mixing")
	await settle()
	bench=home.active_page
	check(WorkbenchSession.state==before and bench.table.ice_effects.is_empty(),"restored cup keeps ice and starts visually settled")
	bench._issue("discard")
	bench._issue("start")
	check(bench.table.ice_effects.is_empty(),"new cup clears old ice animation clocks")
	cup("highball")
	bench._issue("withdraw",{"material":"lime","ml":45,"vessel":"glass"})
	bench._issue("withdraw",{"material":"soda","ml":60,"vessel":"glass"})
	bench._show_category("冰块")
	from_pantry("crushed","glass")
	await wait_settled()
	await capture("26-crushed-ice")
	check(WorkbenchSession.state.session.vessels.glass.ice=="crushed","crushed ice choice remains distinct")
	bench._issue("withdraw",{"material":"gin","ml":30,"vessel":"shaker"})
	from_pantry("cube","shaker")
	await wait_settled()
	bench._act("lid")
	check(WorkbenchSession.state.session.vessels.shaker.ice=="cube","closed opaque shaker keeps its ice state")
	before=WorkbenchSession.snapshot()
	DisplayServer.window_set_size(Vector2i(960,540))
	await settle()
	await capture("27-ice-small")
	check(WorkbenchSession.state==before,"rendering and viewport resize do not mutate cup or stock")
	print("WORKBENCH ICE: %d checks, %d failures" % [count,failures.size()])
	home.queue_free()
	await settle()
	get_tree().quit(0 if failures.is_empty() else 1)
