extends "res://tests/verify_workbench_drag.gd"

func run() -> void:
	Supplies.reset_game()
	WorkbenchSession.reset_game()
	SlotWallet.balance=300000
	SlotWallet.persist()
	home=load("res://scenes/home.tscn").instantiate()
	add_child(home)
	await settle()
	Navigation.go_to(&"mixing")
	await settle()
	bench=home.active_page
	check(bench.item_buttons.is_empty() and bench.pantry_empty.visible,"empty warehouse produces an empty ingredient shelf")
	check(Supplies.purchase("sku_green_chartreuse"),"buy previously omitted spirit")
	check(bench.item_buttons.has("sku_green_chartreuse") and not bench.pantry_empty.visible,"purchase immediately creates previously omitted item")
	check(Art.texture("sku_green_chartreuse")!=null,"new SKU uses shared catalogue texture")
	from_pantry("sku_green_chartreuse","mixing")
	check(is_instance_valid(bench.measure),"newly displayed liquid can actually be poured")
	bench.measure_waiting=false
	bench.measure.set_process(false)
	bench.measure.progress=bench.measure.target/bench.measure.volume_limit()
	space()
	check(Supplies.total_remaining("sku_green_chartreuse")==670 and WorkbenchSession.state.session.vessels.mixing.contents.get("sku_green_chartreuse")==30,"new liquid uses its actual warehouse SKU")
	var seen := {}
	for item: Dictionary in Supplies.catalog.list_items():
		if item.kind=="ingredient" and Supplies.total_remaining(item.id)==0: check(Supplies.purchase(item.id),"purchase "+str(item.id))
	for tab in ["基酒","配料","装饰"]:
		bench._show_category(tab)
		await settle()
		var expected: Array=WorkbenchSession.pantry_items(tab)
		check(bench.item_buttons.size()==expected.size(),"all owned items shown in "+tab)
		for entry in expected:
			check(Art.texture(entry[0])!=null and bench.item_buttons.has(entry[0]),"catalogue material has working shelf art: "+str(entry[0]))
			seen[entry[0]]=true
	check(seen.size()==22,"all 22 shop consumables are represented")
	bench._show_category("基酒")
	await settle()
	check(bench.pantry_items.custom_minimum_size.y>bench.pantry_scroll.size.y,"more than six spirits extend the scroll area")
	bench.pantry_scroll.ensure_control_visible(bench.item_buttons.sku_angostura_bitters)
	await settle()
	check(bench.pantry_scroll.scroll_vertical>0,"last spirit is reachable through scrolling")
	var doses: Dictionary=bench.dose_overrides.duplicate(true)
	var wheel:=InputEventMouseButton.new()
	wheel.button_index=MOUSE_BUTTON_WHEEL_UP
	wheel.pressed=true
	wheel.position=local_point(Vector2(1400,500))
	get_viewport().push_input(wheel,true)
	check(bench.dose_overrides==doses,"scrolling pantry never alters selected pour dose")
	await capture("19-all-owned-spirits")
	Supplies.consume("sku_green_chartreuse",670)
	check(not bench.item_buttons.has("sku_green_chartreuse"),"zero stock disappears immediately")
	Supplies.purchase("sku_green_chartreuse")
	check(bench.item_buttons.has("sku_green_chartreuse"),"restock reappears immediately")
	bench._show_category("配料")
	await settle()
	bench.pantry_scroll.ensure_control_visible(bench.item_buttons.sku_mint_leaf)
	await settle()
	var leaves: float=Supplies.total_remaining("sku_mint_leaf")
	from_pantry("sku_mint_leaf","mixing")
	check(Supplies.total_remaining("sku_mint_leaf")==leaves-1 and WorkbenchSession.state.session.vessels.mixing.solids.get("sku_mint_leaf")==1,"mint leaves consume one piece without inventing ml")
	bench.pantry_scroll.ensure_control_visible(bench.item_buttons.sku_white_cane_sugar)
	await settle()
	var grams: float=Supplies.total_remaining("sku_white_cane_sugar")
	from_pantry("sku_white_cane_sugar","mixing")
	check(Supplies.total_remaining("sku_white_cane_sugar")==grams-1 and WorkbenchSession.amount(WorkbenchSession.state.session.vessels.mixing)==30,"sugar consumes grams separately from liquid volume")
	bench._show_category("装饰")
	await settle()
	await capture("20-owned-garnishes")
	bench._issue("withdraw",{"material":"gin","ml":30,"vessel":"glass"})
	from_pantry("sku_cocktail_cherry","glass")
	check(WorkbenchSession.state.session.vessels.glass.garnish_id=="sku_cocktail_cherry","new garnish can be used")
	bench._show_category("杯子")
	await settle()
	check(bench.item_buttons.size()==4,"all four owned glass types appear")
	click(bench.item_buttons.glass_balloon_glass)
	check(WorkbenchSession.state.session.cup=="glass_balloon_glass" and WorkbenchSession.state.session.vessels.glass.contents.gin==30,"new owned glass replaces presentation while retaining contents")
	check(Supplies.load_state() and WorkbenchSession.load_state(),"new SKU liquids solids garnish and cup survive reload")
	bench._refresh()
	bench._show_category("基酒")
	await settle()
	await capture("21-stock-driven-pantry")
	print("WORKBENCH PANTRY: %d checks, %d failures" % [count,failures.size()])
	home.queue_free()
	await settle()
	get_tree().quit(0 if failures.is_empty() else 1)
