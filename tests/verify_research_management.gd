extends "res://tests/verify_research.gd"
func run() -> void:
	WorkbenchSession.reset_game()
	op("begin_research",{"mode":"research_diy"})
	op("withdraw",{"material":"gin","ml":30,"vessel":"glass"})
	op("finish")
	op("save_research",{"name":"第一版","english_name":"First","notes":"初稿"})
	var original: Dictionary=WorkbenchSession.research_recipes()[0]
	check(MenuCatalog.save_menu([{"id":"diy_1","price":55}],MenuCatalog.design),"list first revision")
	op("select_recipe",{"recipe_id":"diy_1","guest":{"id":"milo"}})
	var frozen: Dictionary=WorkbenchSession.state.session.recipe.duplicate(true)
	op("revise_recipe",{"recipe_id":"diy_1","expected_version":1,"name":"第二版","english_name":"Second","notes":"改笔记"})
	check(WorkbenchSession.research_state().recipes.diy_1.version==2,"metadata creates new version")
	check(WorkbenchSession.research_state().versions.diy_1[0]==original,"old version retained in full")
	check(WorkbenchSession.state.session.recipe==frozen,"active cup keeps original recipe version")
	check(MenuCatalog.get_recipe("diy_1").name=="第二版" and MenuCatalog.entries[0].price==55,"listing reflects revision but keeps price")
	reject("revise_recipe",{"recipe_id":"diy_1","expected_version":1,"name":"stale"})
	reject("delete_recipe",{"recipe_id":"diy_1","expected_version":2})
	op("discard")
	op("begin_research",{"mode":"research_diy","base_recipe_id":"diy_1"})
	op("withdraw",{"material":"gin","ml":20,"vessel":"glass"})
	op("withdraw",{"material":"lime","ml":10,"vessel":"glass"})
	op("finish")
	op("save_research",{"name":"第三版","english_name":"Third","notes":"实际配比修订","replace_id":"diy_1","expected_version":2})
	check(WorkbenchSession.research_recipes().size()==1 and WorkbenchSession.research_recipes()[0].version==3,"new trial revises existing ID without duplicate recipe")
	check(WorkbenchSession.research_state().versions.diy_1.size()==2,"both prior versions retained")
	check(WorkbenchSession._valid(WorkbenchSession.state),"multiple trial save receipts validate across revisions")
	home=load("res://scenes/home.tscn").instantiate()
	add_child(home)
	Navigation.research_view="library"
	Navigation.go_to(&"research")
	await settle()
	bench=home.active_page
	bench._manage_saved()
	await settle()
	check(bench.find_child("RecipeTitleEdit",true,false)!=null,"native management form opens")
	await capture("research-manage-01-versions")
	check(MenuCatalog.save_menu([],MenuCatalog.design),"unlist before deletion")
	op("delete_recipe",{"recipe_id":"diy_1","expected_version":3})
	check(WorkbenchSession.research_recipes().is_empty() and MenuCatalog.get_recipe("diy_1").is_empty(),"delete removes available library and menu candidate")
	check(WorkbenchSession.research_state().versions.diy_1.size()==3 and WorkbenchSession.research_state().archived.diy_1,"delete retains historical versions")
	check(Supplies.load_state() and WorkbenchSession.load_state() and WorkbenchSession._valid(WorkbenchSession.state),"deleted recipe and original saved-drink receipts survive reload")
	op("save_research",{"name":"duplicate","english_name":"","notes":""})
	check(WorkbenchSession.research_recipes().is_empty(),"deleted saved cup cannot be saved a second time")
	print("RESEARCH MANAGEMENT: %d checks, %d failures" % [count,failures.size()])
	home.queue_free()
	await settle()
	get_tree().quit(0 if failures.is_empty() else 1)
