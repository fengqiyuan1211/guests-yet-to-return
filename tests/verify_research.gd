extends "res://tests/verify_workbench_scene.gd"
const Research=preload("res://scripts/research_data.gd")
var serial:=0

func _ready() -> void:
	if DisplayServer.get_name()!="headless": DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS,true)
	if OS.get_cmdline_user_args().has("--research-resume"):
		if not Supplies.save_path.begins_with("/tmp/"):
			get_tree().quit(2)
			return
		call_deferred("resume_check")
	else: super._ready()

func same(a: Variant,b: Variant) -> bool:
	return JSON.parse_string(JSON.stringify(a))==JSON.parse_string(JSON.stringify(b))

func op(kind: String,payload: Dictionary={}) -> bool:
	serial+=1
	var success: bool=WorkbenchSession.command("research-test-%d" % serial,str(WorkbenchSession.state.session.get("id","")),kind,payload)
	check(success,kind+": "+WorkbenchSession.last_error)
	return success

func reject(kind: String,payload: Dictionary={},id: String="") -> void:
	serial+=1
	var before:=Supplies.serialize()
	var state:=WorkbenchSession.snapshot()
	check(not WorkbenchSession.command(id if not id.is_empty() else "research-test-%d" % serial,str(state.session.get("id","")),kind,payload),"reject "+kind)
	check(Supplies.serialize()==before and WorkbenchSession.snapshot()==state,"rejection is atomic: "+kind)

func run() -> void:
	WorkbenchSession.reset_game()
	check(WorkbenchSession.research_state().inspiration==999,"initial inspiration once")
	op("begin_research",{"mode":"research_diy"})
	check(WorkbenchSession.state.session.guest=={} and WorkbenchSession.state.session.recipe.ingredients=={},"DIY has no guest or target")
	var original_recipe: Dictionary=WorkbenchSession.state.session.recipe.duplicate(true)
	var empty_actions: Array=WorkbenchSession.state.session.actions.duplicate(true)
	op("edit_draft",{"material":"gin","amount":45.0,"revision":0})
	check(WorkbenchSession.research_state().inspiration==999 and WorkbenchSession.state.session.actions==empty_actions and WorkbenchSession.state.session.recipe==original_recipe,"draft edits have no inventory charge, physical action or official recipe mutation")
	check(WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==45,"draft sets measuring target")
	reject("begin_research",{"mode":"research_diy"})
	reject("edit_draft",{"material":"gin","amount":-1,"revision":1})
	reject("edit_draft",{"material":"gin","amount":30,"revision":0})
	reject("edit_draft",{"material":"garnish","amount":1.5,"revision":1})
	op("cup",{"cup":"highball"})
	op("ice",{"ice":"cube","vessel":"glass"})
	check(WorkbenchSession.research_state().inspiration==999,"entry cup and ice are free")
	reject("withdraw",{"material":"sku_tonic_water","ml":30,"vessel":"glass"})
	check(WorkbenchSession.research_state().inspiration==999,"failed stock check is free")
	var before:=WorkbenchSession.snapshot()
	var stock:=Supplies.serialize()
	var path: String=Supplies.save_path
	Supplies.save_path=path+"/blocked.json"
	reject("withdraw",{"material":"gin","ml":10,"vessel":"jigger"})
	reject("edit_draft",{"material":"gin","amount":50,"revision":1})
	Supplies.save_path=path
	check(WorkbenchSession.snapshot()==before and Supplies.serialize()==stock,"failed write rolls back inspiration and liquid")
	op("withdraw",{"material":"gin","ml":10,"vessel":"jigger"})
	check(WorkbenchSession.research_state().inspiration==998 and WorkbenchSession.remaining("gin")==590,"first dose charges exactly one inspiration and stock")
	check(WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==35,"liquid already in jigger reduces remaining target")
	var command_id:="research-test-%d" % serial
	var session_id: String=WorkbenchSession.state.session.id
	before=WorkbenchSession.snapshot()
	check(WorkbenchSession.command(command_id,session_id,"withdraw",{"material":"gin","ml":10,"vessel":"jigger"}),"same withdrawal retry accepted")
	check(WorkbenchSession.snapshot()==before,"same withdrawal retry has no extra debit")
	reject("withdraw",{"material":"gin","ml":11,"vessel":"jigger"},command_id)
	check(Supplies.load_state() and WorkbenchSession.load_state(),"mid-cup reload")
	check(same(WorkbenchSession.snapshot(),before),"mid-cup data including charge marker survives")
	op("transfer",{"source":"jigger","vessel":"glass"})
	check(WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==35,"transfer does not count ingredients twice")
	op("withdraw",{"material":"lime","ml":20,"vessel":"glass"})
	op("withdraw",{"material":"syrup","ml":10,"vessel":"glass"})
	op("withdraw",{"material":"soda","ml":100,"vessel":"glass"})
	op("garnish",{"material":"garnish","vessel":"glass"})
	op("withdraw",{"material":"gin","ml":30,"vessel":"shaker"})
	check(WorkbenchSession.research_state().inspiration==998,"subsequent ingredients transfer and garnish do not charge inspiration again")
	var definitions:=WorkbenchSession.MATERIALS.duplicate(true)
	definitions.merge(WorkbenchSession.SOLIDS)
	definitions.merge(WorkbenchSession.GARNISHES)
	var same_facts: Dictionary=WorkbenchSession.state.session.duplicate(true)
	var attributes:=Research.attributes(same_facts,definitions)
	same_facts.recipe={"id":"other","version":1,"name":"Other","ingredients":{"gin":999},"sweetness":99}
	check(Research.attributes(same_facts,definitions)==attributes,"actual sensory attributes independent of recipe identity and targets")
	reject("begin_research",{"mode":"research_diy"})
	op("finish")
	var finished: Dictionary=WorkbenchSession.state.session.duplicate(true)
	check(finished.result.evaluation.tier=="trial" and finished.result.evaluation.score==null and not finished.result.evaluation.has_target,"DIY completion has no classic deviation penalty or target")
	check(finished.result.evaluation.attributes==attributes.attributes and finished.result.waste.gin==30,"sensory uses served cup and preserves waste separately")
	check(WorkbenchSession._valid(WorkbenchSession.state),"research result validates")
	var metadata:={"name":"港口的一页","english_name":"Harbor R and Space","notes":"先量取，再轻轻搅拌；留在摇壶的30 ml不是配方用量。"}
	before=WorkbenchSession.snapshot()
	Supplies.save_path=path+"/blocked.json"
	reject("save_research",metadata)
	Supplies.save_path=path
	check(WorkbenchSession.snapshot()==before,"failed recipe save keeps result and recipe count intact")
	op("save_research",metadata)
	var records:=WorkbenchSession.research_recipes()
	check(records.size()==1 and records[0].name==metadata.name,"named recipe persisted")
	check(records[0].result.draft.targets.gin==45 and records[0].ingredients[0].amount!=45,"finished draft intent stays separate from saved actual recipe")
	var gin_amount:=0.0
	for row in records[0].ingredients:
		if row.sku_id=="sku_gin_london_dry": gin_amount=float(row.amount)
		check(row.inventory_unit==Supplies.get_item(row.sku_id).measurement_unit,"saved ingredient uses canonical warehouse unit: "+row.sku_id)
	check(gin_amount==10 and records[0].result.waste.gin==30,"recipe excludes wasted and retained liquid without deleting original trace")
	op("save_research",metadata)
	check(WorkbenchSession.research_recipes().size()==1 and WorkbenchSession.research_state().inspiration==998,"new command id cannot save one cup twice")
	check(Supplies.load_state() and WorkbenchSession.load_state() and WorkbenchSession.research_recipes().size()==1,"saved library restores")
	var malformed:=WorkbenchSession.snapshot()
	malformed.research.inspiration=-1
	check(not WorkbenchSession._valid(malformed),"invalid research ledger rejected")
	malformed=WorkbenchSession.snapshot()
	malformed.research.recipes.diy_1.ingredients[0].amount="bad"
	check(not WorkbenchSession._valid(malformed),"invalid saved ingredient rejected")
	malformed=WorkbenchSession.snapshot()
	malformed.session.draft.targets.gin="corrupted"
	check(not WorkbenchSession._valid(malformed),"malformed draft rejected")
	malformed=WorkbenchSession.snapshot()
	malformed.session.guest="corrupted"
	check(not WorkbenchSession._valid(malformed),"malformed research guest is rejected without crashing")
	var patched:=WorkbenchSession.snapshot()
	patched.research.inspiration=0
	check(WorkbenchSession._commit(patched),"test depleted inspiration")
	op("start")
	check(WorkbenchSession.state.session.draft.targets.gin==45 and WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==45,"redo retains draft and resets actual progress")
	reject("withdraw",{"material":"gin","ml":10,"vessel":"glass"})
	check(WorkbenchSession.state.session.withdrawn.is_empty(),"no inspiration means no material is consumed")
	patched=WorkbenchSession.snapshot()
	patched.research.inspiration=998
	check(WorkbenchSession._commit(patched),"restore test inspiration")
	op("withdraw",{"material":"gin","ml":10,"vessel":"glass"})
	check(WorkbenchSession.research_state().inspiration==997,"new cup pays once")
	op("discard")
	check(WorkbenchSession.research_state().inspiration==997,"discard does not refund")
	reject("grant_legendary",{"recipe_id":"gin_and_tonic"})
	reject("begin_research",{"mode":"research_legendary","recipe_id":"gin_and_tonic"})
	# Inject a synthetic acquired recipe into the isolated test save, never production data.
	patched=WorkbenchSession.snapshot()
	patched.serial+=1
	var legendary: Dictionary=WorkbenchSession._session(int(patched.serial))
	legendary.mode="research_legendary"
	legendary.inspiration_charged=false
	legendary.inspiration_cost=0
	legendary.sensory_model=Research.sensory_snapshot()
	legendary.recipe.id="test_legendary"
	legendary.recipe.quality_rule=WorkbenchSession.Evaluation.config().rules.workbench_practice.duplicate(true)
	patched.session=legendary
	patched.research.acquired["test_legendary"]="test-recipe-item"
	check(WorkbenchSession._commit(patched),"isolated legendary fixture")
	for material in ["gin","lime","syrup"]: op("withdraw",{"material":material,"ml":legendary.recipe.ingredients[material],"vessel":"shaker"})
	op("ice",{"ice":"cube","vessel":"shaker"})
	op("lid")
	for i in range(16): op("shake",{"vessel":"shaker","seconds":.5,"control":1})
	op("filter",{"source":"shaker","vessel":"glass","integrated_strainer":true})
	op("finish")
	check(WorkbenchSession.state.session.result.evaluation.tier=="perfect" and WorkbenchSession.state.session.result.research_success,"legendary research preserves perfect grade")
	check(WorkbenchSession.research_state().mastered.has("test_legendary") and WorkbenchSession.research_state().inspiration==997,"mastery once with no DIY fee")
	var mastered: Dictionary=WorkbenchSession.research_state().mastered.duplicate()
	op("start")
	op("withdraw",{"material":"gin","ml":20,"vessel":"glass"})
	op("finish")
	check(not WorkbenchSession.state.session.result.research_success and WorkbenchSession.research_state().mastered==mastered,"failed later trial never clears mastery")
	reject("edit_draft",{"material":"gin","amount":50,"revision":0})
	# Native scene integration including text input and journal preview.
	home=load("res://scenes/home.tscn").instantiate()
	add_child(home)
	await settle()
	Navigation.go_to(&"research")
	await settle()
	check(home.active_page.get_script()==load("res://scripts/research.gd"),"home opens real research scene")
	check(home.active_page.desk.visible and not home.active_page.sheet.visible,"physical desk replaces entrance paper menu")
	await capture("research-01-entry")
	var legend_point: Vector2=home.active_page.surface.get_global_transform_with_canvas()*Vector2(1190,330)
	pointer(legend_point,true)
	pointer(legend_point,false)
	await settle()
	check(home.active_page.view=="legendary","physical folio responds to native pointer click")
	await capture("research-02-legendary")
	home.active_page._back()
	await settle()
	check(home.active_page.view=="entry","back from legendary returns to desk")
	var drawer_point: Vector2=home.active_page.surface.get_global_transform_with_canvas()*Vector2(1190,650)
	pointer(drawer_point,true)
	pointer(drawer_point,false)
	await settle()
	check(home.active_page.view=="library","physical drawer responds to native pointer click")
	home.active_page._back()
	await settle()
	op("begin_research",{"mode":"research_diy"})
	Navigation.go_to(&"mixing")
	await settle()
	bench=home.active_page
	check(bench.recipe_title.text.contains("DIY") and not bench.note.text.contains("甜度"),"DIY notes replace target and hide live sensory numbers")
	click(bench.draft_panel.add_button)
	await settle()
	check(is_instance_valid(bench.modal),"add ingredient card opens from native click")
	click(button_named("金酒  ·"))
	await settle()
	check(WorkbenchSession.state.session.draft.targets.gin==30,"picker adds planned amount without withdrawal")
	bench._edit_draft("gin",40,false)
	bench._edit_draft("lime",20,false)
	bench._edit_draft("syrup",10,false)
	await settle()
	var target_field: LineEdit=bench.draft_panel.fields.gin
	click(target_field)
	await settle()
	var typing:=InputEventKey.new()
	typing.keycode=KEY_R
	typing.physical_keycode=KEY_R
	typing.unicode=114
	typing.pressed=true
	get_viewport().push_input(typing,true)
	await settle()
	check(not is_instance_valid(bench.modal) and WorkbenchSession.state.session.status=="mixing","draft typing R does not trigger record shortcut")
	target_field.text="45"
	target_field.text_submitted.emit("45")
	await settle()
	check(WorkbenchSession.state.session.draft.targets.gin==45,"editing target field commits with Enter")
	check(bench.draft_panel.visible and not bench.recipe_panel.visible,"DIY shows editable recipe card")
	check(bench.draft_panel.size.x==400 and bench.table.bottle_rect("gin").position.x>422,"draft panel and bottles fit separate interactive regions")
	op("withdraw",{"material":"gin","ml":15,"vessel":"glass"})
	op("withdraw",{"material":"lime","ml":20,"vessel":"glass"})
	op("withdraw",{"material":"syrup","ml":10,"vessel":"glass"})
	bench._edit_draft("gin",40,false)
	click(bench.draft_panel.fields.gin)
	bench.draft_panel.fields.gin.text="45"
	bench._place_material("gin")
	await settle()
	var bottle_point: Vector2=bench.table.get_global_transform_with_canvas()*bench.table.bottle_rect("gin").get_center()
	pointer(bottle_point,true)
	var drag:=InputEventMouseMotion.new()
	drag.position=bench.table.get_global_transform_with_canvas()*bench.table.POS.jigger
	drag.button_mask=MOUSE_BUTTON_MASK_LEFT
	get_viewport().push_input(drag,true)
	pointer(drag.position,false)
	await settle()
	check(WorkbenchSession.state.session.draft.targets.gin==45,"clicking bottle commits pending text without an extra confirmation")
	check(is_instance_valid(bench.measure) and bench.measure.target==30 and bench.measure.reference,"measuring red line uses edited target45 minus actual15")
	await settle()
	bench.measure.set_process(false)
	check(bench.measure.get_parent().position.x>=448,"measuring overlay does not cover editable recipe")
	await capture("research-10-draft-measure")
	bench._clear_modal()
	bench._edit_draft("gin",10,false)
	bench._begin_measure("gin",99,"jigger")
	check(not is_instance_valid(bench.measure) and WorkbenchSession.state.session.vessels.glass.contents.gin==15,"lower target preserves actual liquid and does not suggest another full dose")
	bench._begin_measure("gin",99,"glass")
	check(is_instance_valid(bench.measure) and not bench.measure.precise,"free pour remains available without visible scale after target met")
	bench._clear_modal()
	bench._edit_draft("gin",45,false)
	bench._edit_draft("soda",150,false)
	check(WorkbenchSession.dose_target("soda",WorkbenchSession.state.session)==60,"large target is split into jigger-sized doses")
	op("withdraw",{"material":"soda","ml":100,"vessel":"glass"})
	op("ice",{"vessel":"glass","ice":"cube"})
	op("garnish",{"material":"garnish"})
	await settle()
	await get_tree().create_timer(.5).timeout
	await capture("research-03-table")
	bench._finish()
	await settle()
	check(is_instance_valid(bench.modal),"research result opens")
	await capture("research-04-result")
	bench._save_research_dialog()
	await settle()
	var field: LineEdit=bench.modal.find_child("ResearchRecipeName",true,false)
	field.text="试调 A R"
	field.grab_focus()
	var key:=InputEventKey.new()
	key.keycode=KEY_R
	key.physical_keycode=KEY_R
	key.unicode=114
	key.pressed=true
	get_viewport().push_input(key,true)
	await settle()
	check(is_instance_valid(field) and bench.modal.find_child("ResearchRecipeName",true,false)==field,"typing R in naming form does not open evaluation details")
	await capture("research-05-name")
	bench._result()
	Navigation.research_view="library"
	Navigation.go_to(&"research")
	await settle()
	check(home.active_page.view=="library","saved recipe library opens")
	await capture("research-06-library")
	Navigation.go_to(&"codex")
	await settle()
	home.active_page._select_filter(3)
	await settle()
	check(home.active_page._visible_recipes().size()==1,"journal DIY category reads saved library")
	await capture("research-07-codex")
	home.active_page.show_detail("diy_1")
	await settle()
	check(home.active_page.detail_id=="diy_1","saved DIY detail opens with actual cup")
	await capture("research-08-detail")
	home.active_page.research_button.pressed.emit()
	await settle()
	check(home.active_page.base_id=="diy_1","codex research action preserves selected reference")
	home.active_page._begin("research_diy")
	await settle()
	check(WorkbenchSession.state.session.base_recipe.id=="diy_1" and WorkbenchSession.state.session.recipe.ingredients.is_empty(),"adaptation freezes reference without making it a scoring target")
	check(home.active_page.note.text.contains("港口的一页"),"adaptation reference appears below actual notebook")
	check(WorkbenchSession.state.session.draft.targets.gin==10,"adapted recipe seeds editable targets from original actual dose")
	op("withdraw",{"material":"gin","ml":10,"vessel":"jigger"})
	check(WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==0,"exact target is complete")
	op("empty",{"vessel":"jigger"})
	check(WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==10,"discarded liquid becomes missing quantity without refunding stock")
	malformed=WorkbenchSession.snapshot()
	malformed.session.base_recipe.ingredients[0].amount="corrupted"
	check(not WorkbenchSession._valid(malformed),"malformed frozen reference is rejected")
	op("discard")
	check(MenuCatalog.unlock_recipe("gin_and_tonic") and MenuCatalog.save_menu([{"id":"gin_and_tonic","price":40}],MenuCatalog.design),"isolate business regression menu")
	op("select_recipe",{"recipe_id":"gin_and_tonic","guest":{"id":"milo"}})
	reject("edit_draft",{"material":"gin","amount":50,"revision":0})
	var inspiration: int=int(WorkbenchSession.research_state().inspiration)
	op("withdraw",{"material":"gin","ml":10,"vessel":"glass"})
	reject("begin_research",{"mode":"research_diy"})
	check(WorkbenchSession.state.session.guest.id=="milo" and WorkbenchSession.research_state().inspiration==inspiration,"research cannot overwrite business half cup or charge inspiration")
	op("finish")
	check(WorkbenchSession.state.session.mode=="workbench" and WorkbenchSession.state.session.result.evaluation.score!=null,"business retains existing quality result")
	DisplayServer.window_set_size(Vector2i(960,540))
	Navigation.go_to(&"research")
	await settle()
	await capture("research-09-small")
	Navigation.go_to(&"mixing")
	await settle()
	op("begin_research",{"mode":"research_diy"})
	home.active_page._clear_modal()
	home.active_page._edit_draft("gin",45,false)
	op("withdraw",{"material":"gin","ml":15,"vessel":"glass"})
	await settle()
	await capture("research-11-small-draft")
	check(WorkbenchSession._valid(WorkbenchSession.state),"final research save validates")
	var expected:=FileAccess.open(Supplies.save_path+".expected",FileAccess.WRITE)
	expected.store_string(JSON.stringify({"workbench":WorkbenchSession.snapshot(),"supplies":Supplies.serialize()}))
	expected.close()
	print("RESEARCH: %d checks, %d failures" % [count,failures.size()])
	home.queue_free()
	await settle()
	get_tree().quit(0 if failures.is_empty() else 1)

func resume_check() -> void:
	var expected: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(Supplies.save_path+".expected"))
	check(same(WorkbenchSession.snapshot(),expected.workbench),"new process restores exact research and session")
	check(same(Supplies.serialize(),expected.supplies),"new process restores exact stock with inspiration")
	check(WorkbenchSession.state.session.draft.targets.gin==45 and WorkbenchSession.dose_target("gin",WorkbenchSession.state.session)==30,"new process retains edited draft and remaining dose")
	print("RESEARCH RESTORE: %d checks, %d failures" % [count,failures.size()])
	get_tree().quit(0 if failures.is_empty() else 1)
