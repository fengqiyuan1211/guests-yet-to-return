; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="致未归的客人"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

OpeningFlow="*res://scripts/opening_flow.gd"
Navigation="*res://scripts/navigation.gd"
LocalServices="*res://scripts/local_services.gd"
TimeManager="*res://scripts/time_manager.gd"
SlotWallet="*res://scripts/slot_wallet.gd"
StoryDialogue="*res://scripts/story_dialogue.gd"
CocktailDatabase="*res://scripts/cocktail_database.gd"
MenuCatalog="*res://scripts/menu_catalog.gd"
Supplies="*res://scripts/supplies.gd"
MenuArt="*res://scripts/menu_art_provider.gd"
WorkbenchSession="*res://scripts/workbench_session.gd"
CustomerService="*res://scripts/customer_service.gd"
GameSession="*res://scripts/game_session.gd"
GuestService="*res://scripts/guest_service.gd"
GuestActivities="*res://scripts/guest_activity_service.gd"
SaloonAudio="*res://scripts/saloon_audio.gd"
PlayModes="*res://scripts/play_modes.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=800
window/size/min_height=450

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
