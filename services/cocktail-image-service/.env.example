# 复制此文件为 .env，仅在服务端填写；不要把密钥放进 Godot 或提交到 Git。
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_TIMEOUT_SECONDS=600
# 默认直接连接千问。仅在部署环境必须使用系统代理时改为 true。
QWEN_USE_SYSTEM_PROXY=false

IMAGE_SERVICE_HOST=127.0.0.1
IMAGE_SERVICE_PORT=8787

IMAGE_SERVICE_TOKEN=
IMAGE_WORKERS=1
IMAGE_MAX_PENDING=16
IMAGE_REFERENCE_IMAGES=true
