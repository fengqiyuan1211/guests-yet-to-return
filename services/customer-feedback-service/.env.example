# Copy to .env in this folder. Leave key blank to use the game's local dialogue.
DEEPSEEK_API_KEY=
# OpenAI-compatible base URL, not the dashboard website.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Change this to the chat model available to your account.
DEEPSEEK_MODEL=deepseek-chat
FEEDBACK_PORT=8788
